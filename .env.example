# ==========================================
# BUSSINEX PRODUCTION & ENVIRONMENT CONFIG
# ==========================================

# Server Port (Local Standalone Server)
PORT=5001

# Persistent PostgreSQL Database Connection URL (Neon / Supabase / AWS RDS / Local Postgres)
# Example: postgresql://username:password@ep-cool-db-123456.us-east-2.aws.neon.tech/bussinex?sslmode=require
DATABASE_URL=
DATABASE_SSL=true

# Authentication Security (JWT Session Signing Key)
# Generate a secure 32+ character key: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_here

# Server-Side Gemini API Key (Strictly kept on server; never exposed to frontend)
GEMINI_API_KEY=
AI_PROVIDER=gemini
AI_MODEL=gemini-2.5-flash
AI_TEMPERATURE=0.2

# Client API Base URL
# In production on Vercel, leave empty to automatically route to same-domain serverless /api
# In development, leave empty to utilize Vite localhost proxy (http://localhost:5001)
VITE_API_URL=
